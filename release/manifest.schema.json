{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verjson.org/schemas/verjson-ci/release-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "commit", "state", "artifacts", "receipts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "state": { "enum": ["staged", "complete", "quarantined"] },
    "quarantineReason": { "type": "string", "minLength": 1 },
    "artifacts": { "type": "object" },
    "receipts": { "type": "object", "required": ["github", "gitlab"] }
  }
}
